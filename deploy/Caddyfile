{
	# Containers: a certificate per public container host, only when the IDP confirms it exists.
	on_demand_tls {
		ask http://backstage:7007/api/containers/tls-ask
	}
}

{$IDP_DOMAIN} {
  # JSON access log on stdout: client IP, status, size and duration for every request,
  # including ones Backstage only logs when they finish. Credentials headers are redacted.
  log {
    output stdout
    format json
  }
  # Public demo URL; preserve Backstage's authenticated plugin router behind it.
  @mockServiceNow path /mock-rest/servicenow
  rewrite @mockServiceNow /api/mock-rest/servicenow
  reverse_proxy backstage:7007
}

# Containers (DESIGN.md §13.5): https://<name>.apps.<IDP_DOMAIN> -> Service <name> in namespace
# apps, resolved through the cluster DNS on this host. {labels.4} is <name> for a three-label
# IDP_DOMAIN such as idp.amirasyraf.dev. Compose sets IDP_APPS_DOMAIN; the default keeps local
# checks (which set IDP_DOMAIN to a bare listener) valid.
*.{$IDP_APPS_DOMAIN:apps.invalid} {
	tls {
		on_demand
	}
	log {
		output stdout
		format json
	}
	reverse_proxy {
		dynamic a {
			name {labels.4}.apps.svc.cluster.local
			port 80
			resolvers 10.43.0.10
		}
	}
}
